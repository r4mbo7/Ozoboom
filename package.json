{
  "name": "ozoboom",
  "version": "0.7.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "cp .githooks/post-checkout \"$(git rev-parse --git-common-dir)/hooks/\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "BALANCE=1 vitest run src/sim/balance.slow.test.ts",
    "e2e": "flock /tmp/ozoboom-e2e.lock playwright test",
    "contrast": "CONTRAST=1 flock /tmp/ozoboom-e2e.lock playwright test e2e/contrast.spec.ts --project=chromium",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "peer": "^1.0.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "pixi.js": "^8.22.0"
  }
}
